# Database Configuration
DB_LOCAL_URL=mongodb://localhost:27017/your_database_name
DB_PRODUCTION_URL=mongodb://localhost:27017/your_database_name

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=your_aws_region
AWS_BUCKET_NAME=your_bucket_name

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SMS Service Configuration (BusinessSMS.co.in - Optional)
SMS_USER_ID=your_sms_user_id
SMS_PASSWORD=your_sms_password
SMS_SENDER_ID=your_sender_id
NOT_VERIFIED_SMS_TEXT=Your account verification is pending.
VERIFIED_SMS_TEXT=Your account has been verified!
SIGNUP_SMS_TEXT=Welcome! Thank you for signing up.
OTP_SMS_TEXT=is your OTP
NOT_VERIFIED_TEMPLATE_ID=your_template_id
VERIFIED_TEMPLATE_ID=your_template_id
SIGNUP_TEMPLATE_ID=your_template_id

# Environment
NODE_ENV=development
